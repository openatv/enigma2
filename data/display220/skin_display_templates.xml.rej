+		</widget>
+	</screen>
+	<screen name="MoviePlayerSummaryArtwork" position="0,0" size="220,176">
+		<widget source="parent.MoviePoster" render="Pixmap" position="4,4" size="73,109" scale="1" alphatest="blend" />
+		<widget source="parent.MovieTitle" render="Label" position="85,4" size="131,54" font="FdLcD;18" />
