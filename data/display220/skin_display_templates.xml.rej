+			<convert type="ClockToText">Default</convert>
+		</widget>
+	</screen>
+	<screen name="MoviePlayerSummaryAdvanced" position="0,0" size="220,176">
+		<widget source="parent.MovieTitle" render="Label" position="4,4" size="212,54" font="FdLcD;18" />
+		<widget source="parent.MovieDetails" render="Label" position="4,58" size="212,86" font="FdLcD;12" />
+		<widget source="session.CurrentService" render="Progress" position="4,147" size="212,5" borderWidth="1">
+			<convert type="ServicePosition">Position</convert>
