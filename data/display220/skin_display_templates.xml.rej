+		<widget source="global.CurrentTime" render="Label" position="146,156" size="69,16" font="FdLcD;12" halign="right" noWrap="1">
+			<convert type="ClockToText">Default</convert>
+		</widget>
+	</screen>
+	<screen name="MovieSelectionSummaryArtwork" position="0,0" size="220,176">
+		<widget source="parent.MoviePoster" render="Pixmap" position="4,4" size="73,109" scale="1" alphatest="blend" />
