<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<skin>
	<!-- Display skin: display240 / Default / OpenATV -->
	<windowstyle id="1" type="skinned">
		<color color="#000000" name="Background"/>
		<color color="#ffffff" name="LabelForeground"/>
		<color color="#000000" name="ListboxBackground"/>
		<color color="#ffffff" name="ListboxForeground"/>
		<color color="#000000" name="ListboxSelectedBackground"/>
		<color color="#ffffff" name="ListboxSelectedForeground"/>
		<color color="#000000" name="ListboxMarkedBackground"/>
		<color color="#ffffff" name="ListboxMarkedForeground"/>
		<color color="#000000" name="ListboxMarkedAndSelectedBackground"/>
		<color color="#ffffff" name="ListboxMarkedAndSelectedForeground"/>
		<color color="#ffffff" name="WindowTitleForeground"/>
		<color color="#000000" name="WindowTitleBackground"/>
	</windowstyle>
	<fonts>
		<!-- pick a funky name for the font, so we don't conflict  -->
		<font filename="nmsbd.ttf" name="FdLcD" scale="100"/>
	</fonts>

<!-- template -->
	<screen name="SummaryClockPanel">
		<widget source="global.CurrentTime" render="Label" position="fill" font="FdLcD;16" halign="right" valign="center" noWrap="1">
			<convert type="ClockToText">DisplayTime</convert>
		</widget>
	</screen>

<!-- main-->
	<screen name="InfoBarSummary" position="0,0" size="240,80">
		<widget source="session.CurrentService" render="Label" position="0,0" size="240,24" font="FdLcD;24" halign="center" foregroundColor="#FFFF00" >
			<convert type="ServiceName">Name</convert>
		</widget>
		<widget source="session.Event_Now" render="Label" position="0,26" size="240,22" font="FdLcD;19" halign="center" noWrap="1" >
			<convert type="EventName">Name</convert>
		</widget>
		<widget source="session.Event_Now" render="Progress" position="0,50" size="240,7" borderWidth="1" >
			<convert type="EventTime">Progress</convert>
		</widget>
		<widget source="session.Event_Now" render="Label" position="80,60" size="80,20" font="Regular;16" halign="center" foregroundColor="#F78181" noWrap="1" >
			<convert type="EventTime">Remaining</convert>
			<convert type="RemainingToText"></convert>
		</widget>
		<eLabel text="TUNER:" position="0,60" size="55,20" halign="left" font="FdLcD;14" />
		<widget source="session.FrontendInfo" render="FixedLabel" position="55,60" size="20,20" text="A" foregroundColor="#ff0000" font="FdLcD;16" halign="center" >
			<convert type="FrontendInfo">NUMBER</convert>
			<convert type="ValueRange">0,0</convert>
			<convert type="ConditionalShowHide" />
		</widget>
		<widget source="session.FrontendInfo" render="FixedLabel" position="55,60" size="20,20" text="B" foregroundColor="#04B404" font="FdLcD;16" halign="center" >
			<convert type="FrontendInfo">NUMBER</convert>
			<convert type="ValueRange">1,1</convert>
			<convert type="ConditionalShowHide" />
		</widget>
		<widget source="session.FrontendInfo" render="FixedLabel" position="55,60" size="20,20" text="C" foregroundColor="#04B404" font="FdLcD;16" halign="center" >
			<convert type="FrontendInfo">NUMBER</convert>
			<convert type="ValueRange">2,2</convert>
			<convert type="ConditionalShowHide" />
		</widget>
		<widget source="session.FrontendInfo" render="FixedLabel" position="55,60" size="20,20" text="D" foregroundColor="#04B404" font="FdLcD;16" halign="center" >
			<convert type="FrontendInfo">NUMBER</convert>
			<convert type="ValueRange">3,3</convert>
			<convert type="ConditionalShowHide" />
		</widget>
		<widget source="session.RecordState" render="FixedLabel" text="Recording" position="0,60" size="80,20" halign="left" foregroundColor="#ff0000" font="FdLcD;14" zPosition="1" noWrap="1" >
			<convert type="ConfigEntryTest">config.usage.blinking_rec_symbol_during_recording,True,CheckSourceBoolean</convert>
			<convert type="ConditionalShowHide">Blink</convert>
		</widget>
		<widget source="session.RecordState" render="FixedLabel" text="Recording" position="0,60" size="80,20" halign="left" foregroundColor="#ff0000" font="FdLcD;14" zPosition="1" noWrap="1" >
			<convert type="ConfigEntryTest">config.usage.blinking_rec_symbol_during_recording,False,CheckSourceBoolean</convert>
			<convert type="ConditionalShowHide" />
		</widget>
		<panel name="SummaryClockPanel" position="160,60" size="80,20" />
	</screen>

<!-- movieplayer-->
	<screen name="InfoBarMoviePlayerSummary" position="0,0" size="240,80">
		<widget source="session.CurrentService" render="Label" position="0,0" size="240,35" foregroundColor="#FFFF00" font="FdLcD;24" valign="center" halign="center" zPosition="14">
			<convert type="ServiceName">Name</convert>
		</widget>
		<widget source="session.CurrentService" render="Progress" position="0,40" size="240,12" foregroundColor="#02c6ff" borderWidth="2">
			<convert type="ServicePosition">Position</convert>
		</widget>
		<widget source="session.CurrentService" render="Label" position="0,56" size="150,24" font="FdLcD;20" halign="left" foregroundColor="#02c6ff" >
			<convert type="ServicePosition">Remaining,Negate</convert>
		</widget>
		<panel name="SummaryClockPanel" position="160,60" size="80,20" />
	</screen>
	<screen name="MovieContextMenuSummary" position="0,0" size="240,80">
		<widget source="parent.Title" render="Label" position="0,0" foregroundColor="#FFFF00" size="240,35" font="FdLcD;24" halign="center" valign="center" />
		<widget source="selected" render="Label" position="0,40" size="240,35" font="FdLcD;21" halign="center" valign="top" foregroundColor="#02c6ff" />
	</screen>
	<screen name="MovieSelectionSummary" position="0,0" size="240,80">
		<widget source="parent.Title" render="Label" position="0,0" size="240,22" foregroundColor="#FFFF00" font="FdLcD;20" halign="center" zPosition="14" noWrap="1" />
		<widget source="name" render="Label" position="0,22" foregroundColor="#02c6ff" size="240,36" font="FdLcD;18" halign="center" valign="center" />
		<widget source="parent.Service" render="Label" position="0,60" size="115,20" font="FdLcD;18" halign="left" transparent="1" foregroundColor="#02c6ff" >
			<convert type="ServiceTime">Duration</convert>
			<convert type="ClockToText">AsLength</convert>
		</widget>
		<widget source="parent.Service" render="Label" position="125,60" size="115,20" font="FdLcD;18" halign="right" transparent="1" foregroundColor="#02c6ff" >
			<convert type="MovieInfo">FileSize</convert>
		</widget>
    </screen>

<!-- channelselection-->
	<screen name="ChannelSelectionSummary" position="fill">
		<widget source="parent.ServiceEvent" render="Label" position="top" foregroundColor="#FFFF00" size="*,26" font="FdLcD;24" halign="center" noWrap="1" >
			<convert type="ServiceName">Name</convert>
		</widget>
		<widget source="parent.ServiceEvent" render="Label" position="top" size="*,26" font="FdLcD;20" halign="center" noWrap="1" >
			<convert type="EventName">Name</convert>
		</widget>
		<widget source="parent.ServiceEvent" render="Progress" position="top" size="*,7" borderWidth="1">
			<convert type="EventTime">Progress</convert>
		</widget>
		<panel position="bottom" size="*,20" name="SummaryClockPanel" />
	</screen>
	<screen name="ChannelSelectionDefaultSummary" position="fill">
		<panel name="ChannelSelectionSummary" />
	</screen>

<!-- menus-->
	<screen name="MenuSummary" position="fill">
